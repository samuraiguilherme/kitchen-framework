{
  "version": 1,
  "base": "origin/develop",
  "github": {
    "repository": "HireBus/hirebus-v3"
  },
  "providers": {
    "author": {
      "provider": "codex",
      "model": "gpt-6.1-sol"
    },
    "review": {
      "provider": "claude",
      "model": "sonnet"
    },
    "timeoutMs": 3600000
  },
  "stations": {
    "intent": { "reviewEnabled": false },
    "spec": { "reviewEnabled": false },
    "plan": { "reviewEnabled": false },
    "test-plan": { "reviewEnabled": false },
    "unit-tests": { "reviewEnabled": false },
    "implementation": { "reviewEnabled": false },
    "verify": { "reviewEnabled": false },
    "publish": { "reviewEnabled": false }
  },
  "profiles": {
    "kitchen-unit": {
      "version": "1.0.0",
      "kind": "unit",
      "cwd": "tools/kitchen",
      "command": "pnpm",
      "args": ["exec", "vitest", "run", "{files}", "--reporter=json"],
      "parser": "vitest-json",
      "timeoutMs": 180000,
      "setup": {
        "command": "pnpm",
        "args": [
          "install",
          "--offline",
          "--frozen-lockfile",
          "--ignore-scripts",
          "--filter",
          "@hirebus/kitchen..."
        ],
        "timeoutMs": 180000
      }
    },
    "crm-unit": {
      "version": "1.0.0",
