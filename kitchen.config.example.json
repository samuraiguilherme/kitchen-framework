{
  "version": 1,
  "base": "origin/main",
  "github": { "repository": "" },
  "providers": {
    "author": { "provider": "codex" },
    "review": { "provider": "claude" },
    "timeoutMs": 600000
  },
  "discovery": { "enabled": false },
  "stations": {},
  "profiles": {
    "unit": {
      "version": "1.0.0",
      "kind": "unit",
      "cwd": ".",
      "command": "pnpm",
      "args": ["exec", "vitest", "run", "{files}", "--reporter=json"],
      "parser": "vitest-json",
      "timeoutMs": 180000
    },
    "manual-flow": { "version": "1.0.0", "kind": "manual" }
  }
}
