{
  "name": "kitchen",
  "version": "0.1.0",
  "description": "A local, human-approved feature development workflow for any Git project.",
  "private": true,
  "type": "module",
  "bin": {
    "kitchen": "bin/kitchen.mjs"
  },
  "files": [
    "bin",
    "src",
    "rubrics",
    "examples",
    "templates",
    "kitchen.config.example.json",
    "kitchen.config.deepseek.example.json",
    "docs/local-deepseek.md",
    "scripts/setup-deepseek.ps1"
  ],
  "scripts": {
    "kitchen": "node bin/kitchen.mjs",
    "cli": "tsx src/cli.ts",
    "test": "vitest run",
    "check:types": "tsc --noEmit",
    "lint": "oxlint -c .oxlintrc.json ."
  },
  "dependencies": {
    "ajv": "8.18.0",
    "cross-spawn": "7.0.6",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/cross-spawn": "6.0.6",
    "@types/node": "22.19.15",
    "oxlint": "1.56.0",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  }
}
